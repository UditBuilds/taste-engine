# --- Phase 2: metadata resolution (read-only) -------------------------------
# videos.list reads PUBLIC data, so an API key is enough - no OAuth consent
# screen, no browser flow.
#   1. https://console.cloud.google.com/apis/library/youtube.googleapis.com -> Enable
#   2. APIs & Services -> Credentials -> Create credentials -> API key
YT_API_KEY=your-api-key

# --- Phase 4: write-back (touches your account) -----------------------------
# Creating playlists needs OAuth. Credentials -> Create credentials ->
# OAuth client ID -> Desktop app.
YT_CLIENT_ID=your-client-id.apps.googleusercontent.com
YT_CLIENT_SECRET=your-client-secret

# --- Quota ------------------------------------------------------------------
# Google's per-project ceiling is 10000 units/day and cannot be purchased.
# QuotaLedger enforces this cap and refuses any call that would breach it.
YT_DAILY_QUOTA_CAP=8000
